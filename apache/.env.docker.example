# Copy to .env.docker. Never commit real secrets.
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
GUEST_TOKEN_JWT_SECRET=replace-with-another-long-random-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace-with-existing-superset-password

# MySQL runs on Windows host. Use host.docker.internal from Superset.
MYSQL_URI=mysql+pymysql://root:@host.docker.internal:3306/temulkpp
LARAVEL_URL=http://host.docker.internal:8000
SUPERSET_URL=http://localhost:8088
CORS_ORIGINS=http://localhost:8000
