services:
  db:
    image: mysql:8.0
    container_name: temulkpp-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: temulkpp
      MYSQL_ALLOW_EMPTY_PASSWORD: "yes"
    ports:
      - "3306:3306"
    volumes:
      - dbdata:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 3s
      retries: 10

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile
    image: temulkpp-backend:1.0
    container_name: temulkpp-backend
    restart: unless-stopped
    ports:
      - "127.0.0.1:8000:80"
    env_file:
      - ./.env.docker
    depends_on:
      db:
        condition: service_healthy
    volumes:
      - ./app:/var/www/html/app
      - ./bootstrap:/var/www/html/bootstrap
      - ./config:/var/www/html/config
      - ./resources:/var/www/html/resources
      - ./routes:/var/www/html/routes
      - ./bootstrap/cache:/var/www/html/bootstrap/cache
      - ./public:/var/www/html/public
      - ./storage:/var/www/html/storage
    mem_limit: 768m
    cpus: 1.0
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1/up || exit 1"]
      interval: 5s
      timeout: 3s
      start_period: 15s
      retries: 5

  frontend:
    build:
      context: .
      dockerfile: frontend/Dockerfile
    image: temulkpp-frontend:1.0
    container_name: temulkpp-frontend
    restart: unless-stopped
    ports:
      - "127.0.0.1:5173:5173"
    volumes:
      - ./public:/app/public
    mem_limit: 384m
    cpus: 0.75
    depends_on:
      backend:
        condition: service_healthy

volumes:
  dbdata: