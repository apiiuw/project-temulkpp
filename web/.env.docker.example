APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=base64:replace-with-existing-laravel-app-key

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=temulkpp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

